# ====================================================================
# OFFICIAL UNREAL ENGINE GITIGNORE TEMPLATE
# Place this file in your root project folder (next to the .uproject)
# ====================================================================

# Visual Studio & IDE user-specific files
.vs/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# JetBrains Rider / CLion settings
.idea/
*.csproj
*.sln.DotSettings
*.sln.DotSettings.user

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# ====================================================================
# Unreal Engine Core Generated Directories
# These can all be safely regenerated by the engine when opening
# ====================================================================
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/

# Ignore plugin-specific generated folders
Plugins/**/Binaries/
Plugins/**/Intermediate/
Plugins/**/Saved/

# Precompiled Assets Source paths (optional cache)
SourceArt/**/*.png
SourceArt/**/*.tga

# Whitelist exceptions (Make sure critical config files aren't locked out)
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt